model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-MX
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["alndomain","worktype","workorder","site","labor","person","alndomainClass","locations","Alias_de_jobplan_Reincidencias","lochierarchy","jobplan","matusetrans","Alias_de_alndomain_Appa","Alias_de_alndomain_Sacs","Alias_de_alndomain_CeCo","Alias_de_alndomine_Usage","asset","synonymdomain","pm","labtrans","craft","modavail","personcal","shiftpatternday","laborcraftrate","DAX_Condicionales","DAX_Metricas","Parámetro de Cadena de Conexión","Parámetro de Cadena de Conexión Oracle","Alias_de_Person","Alias_de_asset","TEC PERFIL USUARIO","MAXIMO_10","RangeStart","RangeEnd"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

annotation __TEdtr = 1

ref table alndomain
ref table worktype
ref table workorder
ref table site
ref table labor
ref table person
ref table alndomainClass
