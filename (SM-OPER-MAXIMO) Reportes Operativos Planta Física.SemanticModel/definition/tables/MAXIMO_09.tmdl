	column ConcatJPNUM =
			
			VAR _MEDIDA = CALCULATE(DISTINCTCOUNT(MAXIMO_09[Concat_Reincidencia]))
			RETURN
			IF(
			    _MEDIDA>2,1,_MEDIDA
			)
		formatString: 0
		lineageTag: 211ae72a-e534-4f38-8e64-d782c5d565c5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition MAXIMO_09 = calculated
		mode: import
		source = ```
				
				VAR tblWorkorder = 
				    SELECTCOLUMNS(
				        FILTER(
				            workorder,
				            workorder[Estado] IN {"CERR","APROB","EMAT"} && 
				            workorder[Es Tarea] = 0 && 
				            workorder[Tipo de Trabajo] IN {"MC-SAI","MC-PROG"}
				        ),
				        "Wo_organización", workorder[Organización],
				        "Wo_Campus", workorder[Campus],
				        "Wo_Mano de Obra", workorder[Mano de Obra Asignada],
				        "Wo_Clasificación", workorder[Clasificación],
				        "Wo_subcla", workorder[Subclasificación],
				        "wo_Plan Trabajo", workorder[Plan de Trabajo],
				        "Wo_Ubicación", workorder[Ubicación],
				        "wo_Orden Trabajo", workorder[Orden de Trabajo],
				        "wo_Estado", workorder[Estado],
				        "wo_Descripcion", workorder[Descripción],
				        "wo_nombre", workorder[Usuario],
				        "wo_actstart", workorder[actstart],
				        "wo_actfinish", workorder[actfinish],
				        "wo_schedstart", workorder[schedstart],
				        "wo_schedfinish", workorder[schedfinish],
				        "wo_schedfinish2", workorder[schedfinish2],
				        "wo_Tipo Trabajo", workorder[Tipo de Trabajo],
				        "key_Sub", workorder[Subclasificación] & "",
				        "key_cla",workorder[Clasificación]&"",
				        "keyOS",workorder[Organización]&workorder[Campus],
				        "keyWT",workorder[Tipo de Trabajo]&"",
				        "keyOSL", workorder[Organización] & workorder[Campus] & workorder[Ubicación],
				         "KeyJOB",workorder[Organización] & workorder[Plan de Trabajo] & workorder[Clasificación],
				         "KeyJOB2",workorder[Organización]&workorder[Plan de Trabajo]&workorder[Tipo de Trabajo]&workorder[Clasificación]&workorder[Subclasificación],
				         "KeyLabor",workorder[Organización]&workorder[Mano de Obra Asignada],
				         "Key_loc",workorder[Organización]&workorder[Campus]&workorder[Ubicación],
				         "Key_Labor_Persona",workorder[Organización]&workorder[Mano de Obra Asignada],
				        "Concat_Reincidencia", 
				            IF(
				                NOT(ISBLANK(workorder[Plan de Trabajo])), 
				                workorder[Plan de Trabajo], 
				                "S/CodTarea"
				            ) & "_" & 
				            IF(
				                NOT(ISBLANK(workorder[Ubicación])), 
				                workorder[Ubicación], 
				                "S/Ubicación"
				            )
				    )
				
				
				            
				
				    var tblAlias_de_alndomain_Class =
														CALCULATETABLE(
				 										SELECTCOLUMNS(alndomainClass, "Subclasificacion",alndomainClass[description],
																		"key_Sub", alndomainClass[value]&"" ),
																		alndomainClass[domainid]="TM_SUBCLASIFICACIO"
																		)
				    
				                                                        
				   var tblLocations = SELECTCOLUMNS( locations, 
				                    "keyOSL", locations[Organización]&locations[Campus]&locations[Ubicacion],
				                     "Edificio",locations[Nombre Edificio],"Nivel",locations[Nivel Edificio],"ubicacion_edif",locations[Ubicacion] )
				
				   var tbl_Alias_de_jobplan_Reincidencias = SELECTCOLUMNS( jobplan, "alias_description",jobplan[Descripción],
				                     "KeyJOB",jobplan[Organización]&jobplan[Plan Trabajo]&jobplan[Clasificación]
				   )
				
				   var tbl_jobplan = SELECTCOLUMNS( jobplan, "jobplan_description",jobplan[Descripción],
				                     "KeyJOB2",jobplan[Organización]&jobplan[Plan Trabajo]&jobplan[Tipo Trabajo]&jobplan[Clasificación]&jobplan[Subclasificación]
				   )
				
				   var tblSite = SELECTCOLUMNS(site, "Site_Campus",site[Descripción], "keyOS",site[Organización]&site[Campus])	
				
				   var tblWorktype = SELECTCOLUMNS(worktype, "Tipo Trabajo_desc",worktype[TipoTrabajo]& ":" & worktype[Descripción], "keyWT",worktype[TipoTrabajo]&"")	
				
				   var tblLabor = SELECTCOLUMNS(labor,"labor_mano de obra",labor[Mano de Obra],"labor_persona",labor[Persona],"organizacion",labor[Organización],"Key_Persona",labor[Persona]&labor[Organización])
				
				   var tblPerson = SELECTCOLUMNS(person,"Nombre_Persona",person[Nombre],"Person_Id",person[Persona],"Key_Persona",person[Persona]&person[Organización])
				
				   var _Labor_Person = NATURALLEFTOUTERJOIN(tblLabor,tblPerson)
				
				   
				   var tblLoc = SELECTCOLUMNS(lochierarchy,"Parent",lochierarchy[Nivel Superior],"Key_loc",lochierarchy[Organización]&lochierarchy[Campus]&lochierarchy[Ubicación])
				
				   var tbl_labor_person = 
				   ADDCOLUMNS(
				   NATURALLEFTOUTERJOIN(tblLabor,tblPerson),
				   "Key_Labor_Persona",[organizacion]&[labor_mano de obra]
				   )
				
				
				   var tblAlias_de_alndomain =
														CALCULATETABLE(
				 										SELECTCOLUMNS(alndomain, "clasificacion",alndomain[Descripción],
																		"key_cla", alndomain[Valor Dominio]&"" ),
																		alndomain[ID Dominio]="TM_CLASIFICACION"
																		)
				RETURN
				NATURALLEFTOUTERJOIN(
				NATURALLEFTOUTERJOIN(
				NATURALLEFTOUTERJOIN(
				NATURALLEFTOUTERJOIN(
				NATURALLEFTOUTERJOIN(
				NATURALLEFTOUTERJOIN(
				NATURALLEFTOUTERJOIN(
				NATURALLEFTOUTERJOIN(
				NATURALLEFTOUTERJOIN(tblWorkorder, tblAlias_de_alndomain_Class), tblLocations
				),  tbl_Alias_de_jobplan_Reincidencias
				),tbl_jobplan
				),
				tblSite
				),
				tblWorktype
				),tblLoc
				),tblAlias_de_alndomain
				),tbl_labor_person
				)
				```

	annotation PBI_Id = 7799c8230def416ead4c0536696de360

