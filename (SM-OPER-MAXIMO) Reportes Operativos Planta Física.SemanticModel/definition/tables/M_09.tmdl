	partition M_09 = calculated
		mode: import
		source = ```
				
				VAR TablaReincidencias = 
				    ADDCOLUMNS(
				        SUMMARIZE(
				            MAXIMO_09,
				            MAXIMO_09[organizacion],
				            MAXIMO_09[Site_Campus],
				            MAXIMO_09[Concat_Reincidencia],
				            MAXIMO_09[Wo_Ubicación],
				            MAXIMO_09[clasificacion],
				            MAXIMO_09[Subclasificacion],
				            MAXIMO_09[jobplan_description],
				            MAXIMO_09[wo_Plan Trabajo],
				            MAXIMO_09[wo_Orden Trabajo],
				            MAXIMO_09[wo_Descripcion],
				            MAXIMO_09[wo_nombre],
				            MAXIMO_09[Nombre_Persona],
				            MAXIMO_09[wo_actstart],
				            MAXIMO_09[wo_actfinish],
				            MAXIMO_09[wo_schedstart],
				            MAXIMO_09[wo_schedfinish],
				            MAXIMO_09[Nivel],
				            MAXIMO_09[Parent],
				            MAXIMO_09[Edificio]
				        ),
				        "CtaOTCReincidencia", CALCULATE(COUNT(MAXIMO_09[Concat_Reincidencia]))
				    )
				RETURN 
				    TablaReincidencias
				
				
				
				
				
				
				
				```

	annotation PBI_Id = 25c8c3750de44f93865ef414ffb3bd2c

